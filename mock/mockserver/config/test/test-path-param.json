[
    {
        "httpRequest": {
            "method": "GET",
            "path": "/test/path-param/{id}",
            "pathParameters": {
                "id": ["[0-9]+"]
            }
        },
        "httpResponseTemplate": {
            "templateType": "VELOCITY",
            "template": "{ \"statusCode\": 200, \"headers\": { \"Content-Type\": [ \"application/json\" ] }, \"body\": \"{ \\\"id\\\": \\\"$!request.pathParameters['id'][0]\\\", \\\"message\\\": \\\"Received id $!request.pathParameters['id'][0]\\\" }\" }"
        }
    }
]
