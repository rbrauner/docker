{
    "request": {
        "method": "POST",
        "urlPath": "/test/body-match",
        "bodyPatterns": [
            {
                "matchesJsonPath": {
                    "expression": "$.product",
                    "equalTo": "book"
                }
            }
        ]
    },
    "response": {
        "status": 200,
        "jsonBody": {
            "message": "Body matched: product=book"
        }
    }
}
